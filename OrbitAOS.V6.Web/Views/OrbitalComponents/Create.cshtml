@model OrbitAOS.V6.Application.DTOs.OrbitalComponentDto
@{
    ViewData["Title"] = "Create Orbital Component";
}

<h1>Create Orbital Component</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter component name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ComponentType" class="form-label"></label>
                <input asp-for="ComponentType" class="form-control" placeholder="e.g. Satellite, Probe, Station" />
                <span asp-validation-for="ComponentType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Decommissioned">Decommissioned</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AltitudeKm" class="form-label"></label>
                <input asp-for="AltitudeKm" class="form-control" type="number" step="0.01" placeholder="Altitude in km" />
                <span asp-validation-for="AltitudeKm" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InclinationDegrees" class="form-label"></label>
                <input asp-for="InclinationDegrees" class="form-control" type="number" step="0.0001" placeholder="Inclination in degrees" />
                <span asp-validation-for="InclinationDegrees" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

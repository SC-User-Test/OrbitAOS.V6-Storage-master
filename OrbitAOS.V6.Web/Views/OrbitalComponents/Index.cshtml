@model IReadOnlyList<OrbitAOS.V6.Application.DTOs.OrbitalComponentDto>
@{
    ViewData["Title"] = "Orbital Components";
}

<h1>Orbital Components</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No orbital components found. Create one to get started.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Altitude (km)</th>
                <th>Inclination (°)</th>
                <th>Active</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ComponentType</td>
                    <td>
                        <span class="badge @(item.Status == "Active" ? "bg-success" : "bg-secondary")">
                            @item.Status
                        </span>
                    </td>
                    <td>@(item.AltitudeKm.HasValue ? item.AltitudeKm.Value.ToString("N0") : "—")</td>
                    <td>@(item.InclinationDegrees.HasValue ? item.InclinationDegrees.Value.ToString("N2") : "—")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

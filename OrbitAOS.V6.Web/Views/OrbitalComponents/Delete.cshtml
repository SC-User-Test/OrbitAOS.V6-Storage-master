@model OrbitAOS.V6.Application.DTOs.OrbitalComponentDto
@{
    ViewData["Title"] = "Delete Orbital Component";
}

<h1>Delete Orbital Component</h1>

<div class="alert alert-danger">
    <strong>Warning:</strong> Are you sure you want to delete this orbital component? This action cannot be undone.
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@Model.Name</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Component Type</dt>
            <dd class="col-sm-9">@Model.ComponentType</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
